        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "The NUin program is a program for freshmen in which they study abroad (in a satellite campus) for their first semester. The locations are ",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "The NUin program is a program for freshmen in which they study abroad (in a satellite campus) for their first semester. The locations are ",
            "href": null
          },
          {
            "type": "text",
            "text": {
              "content": "listed on the website",
              "link": {
                "url": "https://nuin.northeastern.edu/"
              }
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "listed on the website",
            "href": "https://nuin.northeastern.edu/"
          },
          {
            "type": "text",
            "text": {
              "content": ". Students come to campus in the spring, after which they are considered regular students. The fees of the first semester abroad is usually higher in comparison to the fees of a normal semester.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
