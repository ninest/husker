      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Aid is awarded on a term by term basis. If you are on co-op for spring, you will not be awarded your aid. Your aid will pick back up for Fall if you are enrolled in classes. (Answer from SFS)",
